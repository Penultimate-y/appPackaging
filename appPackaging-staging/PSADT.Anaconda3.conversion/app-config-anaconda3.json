{
  "AppInfo": {
    "Vendor": "Anaconda",
    "Name": "Anaconda3",
    "Version": "Latest",
    "Architecture": "x64",
    "Category": "Data Science"
  },
  "Installation": {
    "Type": "Download",
    "Resolver": {
      "Type": "IndexScrape",
      "IndexUrl": "https://repo.anaconda.com/archive/",
      "LinkPattern": "Anaconda3-(\\d{4}\\.\\d{2}-\\d+)-Windows-x86_64\\.exe"
    },
    "InstallerType": "EXE",
    "InstallerFile": "Anaconda3-Windows-x86_64.exe",
    "SilentArgs": [
      "/InstallationType=AllUsers",
      "/RegisterPython=0",
      "/AddToPath=0",
      "/S",
      "/D=C:\\ProgramData\\Anaconda3"
    ],
    "ProcessesToClose": [
      "python",
      "pythonw"
    ],
    "InstallContext": "System",
    "RequireAdmin": true,
    "OfflineFallback": "Stage the installer in the package Files folder to bypass the download."
  },
  "Uninstall": {
    "Type": "ExePath",
    "Path": "C:\\ProgramData\\Anaconda3\\Uninstall-Anaconda3.exe",
    "Args": [
      "/S"
    ]
  },
  "Detection": {
    "Type": "File",
    "Path": "C:\\ProgramData\\Anaconda3\\python.exe"
  },
  "Provenance": {
    "LegacySources": [
      "legacy.Anaconda"
    ],
    "UrlVerified": true,
    "Notes": "NOTE: Anaconda's commercial terms require a paid licence for organisations over the free-use threshold. Confirm licensing before broad assignment."
  }
}

