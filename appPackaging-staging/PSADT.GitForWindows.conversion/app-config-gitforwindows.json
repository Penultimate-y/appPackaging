{
  "AppInfo": {
    "Vendor": "Git for Windows",
    "Name": "Git for Windows",
    "Version": "Latest",
    "Architecture": "x64",
    "Category": "Developer Tools"
  },
  "Installation": {
    "Type": "Download",
    "Resolver": {
      "Type": "GitHubRelease",
      "Repo": "git-for-windows/git",
      "AssetPattern": "^Git-[\\d\\.]+-64-bit\\.exe$"
    },
    "InstallerType": "EXE",
    "InstallerFile": "Git-64-bit.exe",
    "SilentArgs": [
      "/VERYSILENT",
      "/NORESTART",
      "/NOCANCEL",
      "/SP-",
      "/CLOSEAPPLICATIONS",
      "/RESTARTAPPLICATIONS",
      "/COMPONENTS=gitlfs,assoc,assoc_sh"
    ],
    "ProcessesToClose": [
      "git",
      "git-bash"
    ],
    "InstallContext": "System",
    "RequireAdmin": true,
    "OfflineFallback": "Stage the installer in the package Files folder to bypass the download."
  },
  "Uninstall": {
    "Type": "ExePath",
    "Path": "$env:ProgramFiles\\Git\\unins000.exe",
    "Args": [
      "/VERYSILENT",
      "/NORESTART"
    ]
  },
  "Detection": {
    "Type": "File",
    "Path": "$env:ProgramFiles\\Git\\bin\\git.exe"
  },
  "Provenance": {
    "LegacySources": [
      "legacy.Git"
    ],
    "UrlVerified": true,
    "Notes": "Inno Setup installer. Credential Manager left at installer default."
  }
}

