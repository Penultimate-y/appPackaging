{
  "AppInfo": {
    "Vendor": "Notepad++ Team",
    "Name": "Notepad++",
    "Version": "Latest",
    "Architecture": "x64",
    "Category": "Developer Tools"
  },
  "Installation": {
    "Type": "Download",
    "Resolver": {
      "Type": "GitHubRelease",
      "Repo": "notepad-plus-plus/notepad-plus-plus",
      "AssetPattern": "^npp\\..+\\.Installer\\.x64\\.exe$"
    },
    "InstallerType": "EXE",
    "InstallerFile": "npp-setup.exe",
    "SilentArgs": [
      "/S"
    ],
    "ProcessesToClose": [
      "notepad++"
    ],
    "InstallContext": "System",
    "RequireAdmin": true,
    "OfflineFallback": "Stage the installer in the package Files folder to bypass the download."
  },
  "Uninstall": {
    "Type": "ExePath",
    "Path": "$env:ProgramFiles\\Notepad++\\uninstall.exe",
    "Args": [
      "/S"
    ]
  },
  "Detection": {
    "Type": "File",
    "Path": "$env:ProgramFiles\\Notepad++\\notepad++.exe"
  },
  "Provenance": {
    "LegacySources": [
      "legacy.NotePad++"
    ],
    "UrlVerified": true,
    "Notes": "Latest x64 installer resolved from GitHub releases at install time."
  }
}

